{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/auto_subscribe_pr.py\"",
            "timeout": 15,
            "statusMessage": "Registering PR activity subscription"
          }
        ]
      }
    ]
  }
}
